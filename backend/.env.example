# Local development defaults only. Copy to .env and override as needed.
# Do not use these values for shared, staging, or production environments.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ff_dev
POSTGRES_USER=ff_dev
POSTGRES_PASSWORD=ff_dev_password
DATABASE_URL=postgresql://ff_dev:ff_dev_password@localhost:5432/ff_dev

# Optional: enables admin moderation tools and gateway anti-abuse persistence.
FF_ADMIN_TOKEN=
FF_GATEWAY_CONNECTION_STRING=Host=localhost;Port=5432;Database=ff_dev;Username=ff_dev;Password=ff_dev_password;Include Error Detail=true

# Local auth defaults. Override FF_IDENTITY_TOKEN_SECRET outside development.
FF_IDENTITY_TOKEN_SECRET=ff-development-token-secret-change-me
FF_IDENTITY_ACCESS_TOKEN_LIFETIME_MINUTES=15
FF_IDENTITY_REFRESH_SESSION_DAYS=30
FF_IDENTITY_ACCOUNT_TOKEN_LIFETIME_MINUTES=30

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

NATS_HOST=localhost
NATS_CLIENT_PORT=4222
NATS_MONITORING_PORT=8222
NATS_URL=nats://localhost:4222

# Reserved for future observability compose profiles/configs.
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
