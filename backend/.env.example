# Local development defaults only. Copy to .env or use
# env/development.env.example for the profile-aware scripts.
# Do not use these values for shared, staging, or production environments.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PUBLISHED_PORT=5432
POSTGRES_DB=ff_dev
POSTGRES_USER=ff_dev
POSTGRES_PASSWORD=ff_dev_password
DATABASE_URL=postgresql://ff_dev:ff_dev_password@localhost:5432/ff_dev

FF_DEPLOY_ENV=development
FF_COMPOSE_PROJECT_NAME=ff-backend
FF_CONTAINER_PREFIX=ff
FF_IMAGE_TAG=dev
FF_PORT_BIND_ADDRESS=127.0.0.1
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
FF_DB_INCLUDE_ERROR_DETAIL=true
FF_COMPOSE_ALLOW_BUILD=true

# Optional: enables admin moderation tools and gateway anti-abuse persistence.
FF_ADMIN_TOKEN=
FF_GATEWAY_CONNECTION_STRING=Host=localhost;Port=5432;Database=ff_dev;Username=ff_dev;Password=ff_dev_password;Include Error Detail=true

# Local auth defaults. Override FF_IDENTITY_TOKEN_SECRET outside development.
FF_IDENTITY_TOKEN_SECRET=ff-development-token-secret-change-me
FF_IDENTITY_ACCESS_TOKEN_LIFETIME_MINUTES=15
FF_IDENTITY_REFRESH_SESSION_DAYS=30
FF_IDENTITY_ACCOUNT_TOKEN_LIFETIME_MINUTES=30

# Optional Web Push delivery. Generate VAPID keys for real browser delivery.
FF_PUSH_VAPID_PUBLIC_KEY=
FF_PUSH_VAPID_PRIVATE_KEY=
FF_PUSH_VAPID_SUBJECT=mailto:admin@ff.local
FF_PUSH_DELIVERY_INTERVAL_SECONDS=15

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

NATS_HOST=localhost
NATS_CLIENT_PORT=4222
NATS_MONITORING_PORT=8222
NATS_URL=nats://localhost:4222

# Reserved for future observability compose profiles/configs.
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
