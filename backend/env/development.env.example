# Development profile defaults. Copy to backend/env/development.env or backend/.env
# for local overrides. These values are intentionally local-only.

FF_DEPLOY_ENV=development
FF_COMPOSE_PROJECT_NAME=ff-backend
FF_CONTAINER_PREFIX=ff
FF_IMAGE_TAG=dev
FF_PORT_BIND_ADDRESS=127.0.0.1
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
FF_DB_INCLUDE_ERROR_DETAIL=true
FF_COMPOSE_ALLOW_BUILD=true

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ff_dev
POSTGRES_USER=ff_dev
POSTGRES_PASSWORD=ff_dev_password

FF_IDENTITY_TOKEN_SECRET=ff-development-token-secret-change-me
FF_INTERNAL_SERVICE_TOKEN=ff-development-internal-token-change-me
FF_ADMIN_TOKEN=

FF_IDENTITY_SEED_EMAIL=demo@ff.local
FF_IDENTITY_SEED_PASSWORD=secret
FF_IDENTITY_SEED_USERNAME=demo
FF_IDENTITY_ACCESS_TOKEN_LIFETIME_MINUTES=15
FF_IDENTITY_REFRESH_SESSION_DAYS=30
FF_IDENTITY_ACCOUNT_TOKEN_LIFETIME_MINUTES=30

FF_PUSH_VAPID_PUBLIC_KEY=
FF_PUSH_VAPID_PRIVATE_KEY=
FF_PUSH_VAPID_SUBJECT=mailto:admin@ff.local
FF_PUSH_DELIVERY_INTERVAL_SECONDS=15

GATEWAY_PORT=5124
FF_GATEWAY_PUBLIC_BASE_URL=http://127.0.0.1:5124
IDENTITY_PORT=5125
ADMIN_PORT=5130
ECONOMY_PORT=5141
MARKET_PORT=5275
PLAYER_PORT=5192
PRODUCTION_PORT=5148
RESEARCH_PORT=5268
SOCIAL_CHAT_PORT=5096
WORLD_PORT=5205
COMBAT_PORT=8081
POSTGRES_PUBLISHED_PORT=5432
REDIS_PORT=6379
NATS_CLIENT_PORT=4222
NATS_MONITORING_PORT=8222

REDIS_HOST=redis
REDIS_URL=redis://redis:6379
NATS_HOST=nats
NATS_URL=nats://nats:4222

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
GRAFANA_ADMIN_PASSWORD=admin

FF_SMOKE_EMAIL=demo@ff.local
FF_SMOKE_PASSWORD=secret
