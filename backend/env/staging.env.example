# Staging profile template. Copy to backend/env/staging.env and replace every
# CHANGE_ME value before deploying.

FF_DEPLOY_ENV=staging
FF_COMPOSE_PROJECT_NAME=ff-staging
FF_CONTAINER_PREFIX=ff-staging
FF_IMAGE_TAG=staging
FF_PORT_BIND_ADDRESS=127.0.0.1
ASPNETCORE_ENVIRONMENT=Staging
DOTNET_ENVIRONMENT=Staging
FF_DB_INCLUDE_ERROR_DETAIL=false
FF_COMPOSE_ALLOW_BUILD=false

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ff_staging
POSTGRES_USER=ff_staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_POSTGRES_PASSWORD

FF_IDENTITY_TOKEN_SECRET=CHANGE_ME_STAGING_IDENTITY_TOKEN_SECRET
FF_INTERNAL_SERVICE_TOKEN=CHANGE_ME_STAGING_INTERNAL_SERVICE_TOKEN
FF_ADMIN_TOKEN=CHANGE_ME_STAGING_ADMIN_TOKEN

# Leave seed credentials empty in shared environments. Use FF_SMOKE_* for a
# dedicated smoke-test account if authenticated smoke checks are needed.
FF_IDENTITY_SEED_EMAIL=
FF_IDENTITY_SEED_PASSWORD=
FF_IDENTITY_SEED_USERNAME=
FF_IDENTITY_ACCESS_TOKEN_LIFETIME_MINUTES=15
FF_IDENTITY_REFRESH_SESSION_DAYS=14
FF_IDENTITY_ACCOUNT_TOKEN_LIFETIME_MINUTES=30

FF_PUSH_VAPID_PUBLIC_KEY=CHANGE_ME_STAGING_VAPID_PUBLIC_KEY
FF_PUSH_VAPID_PRIVATE_KEY=CHANGE_ME_STAGING_VAPID_PRIVATE_KEY
FF_PUSH_VAPID_SUBJECT=mailto:ops-staging@example.com
FF_PUSH_DELIVERY_INTERVAL_SECONDS=15

GATEWAY_PORT=5124
FF_GATEWAY_PUBLIC_BASE_URL=http://127.0.0.1:5124
IDENTITY_PORT=5125
ADMIN_PORT=5130
ECONOMY_PORT=5141
MARKET_PORT=5275
PLAYER_PORT=5192
PRODUCTION_PORT=5148
RESEARCH_PORT=5268
SOCIAL_CHAT_PORT=5096
WORLD_PORT=5205
COMBAT_PORT=8081
POSTGRES_PUBLISHED_PORT=5432
REDIS_PORT=6379
NATS_CLIENT_PORT=4222
NATS_MONITORING_PORT=8222

REDIS_HOST=redis
REDIS_URL=redis://redis:6379
NATS_HOST=nats
NATS_URL=nats://nats:4222

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STAGING_GRAFANA_ADMIN_PASSWORD

FF_SMOKE_EMAIL=
FF_SMOKE_PASSWORD=
